# .dockerignore for Nuotti root context (Backend + Audience + Performer builds)

# Git
.git/
.gitignore
.github/

# IDE
.vs/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build outputs
**/bin/
**/obj/
**/publish/

# Documentation
*.md
docs/
README.md

# Tests
**/*.Tests/
*.Tests/

# Node modules (web project)
web/node_modules/
web/build/

# Development only
**/*.Development.json
**/launchSettings.json

# CI/CD
.github/
deploy/

# Tools
tools/

# Venue-local and tooling projects. These are never part of a hosted image:
# Projector and AudioEngine run on the band's machine (Nuotti/Program.cs marks both
# ExcludeFromManifest), SimKit is a scripting harness, and web has its own build context.
# Nuotti.Performer is deliberately NOT listed - it is a hosted Blazor Server app and needs
# to be in this context for Nuotti.Performer/Dockerfile to build.
Nuotti.Projector/
Nuotti.AudioEngine/
Nuotti.SimKit/
web/



