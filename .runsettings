<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>json,cobertura,opencover</Format>
          <Exclude>[*.Tests]*,[*.Test]*</Exclude>
          <IncludeDirectory>../</IncludeDirectory>
          <SingleHit>false</SingleHit>
          <UseSourceLink>true</UseSourceLink>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>true</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
  <RunConfiguration>
    <MaxCpuCount>0</MaxCpuCount>
    <ResultsDirectory>./TestResults</ResultsDirectory>
    <EnvironmentVariables>
      <!-- Stop Verify/DiffEngine launching the OS diff tool (a Rider window per failing
           snapshot test, per run). Belt-and-braces with VerifierSettings.DisableDiff(). -->
      <DiffEngine_Disabled>true</DiffEngine_Disabled>
    </EnvironmentVariables>
    <TreatTestAdapterErrorsAsWarnings>false</TreatTestAdapterErrorsAsWarnings>
    <!-- Note: xUnit doesn't support retry in .runsettings. Use deterministic seeds and mark flaky tests with [Trait("Flaky", "true")] -->
  </RunConfiguration>
  <!-- There is deliberately no MSTest section. Every test project here uses xUnit, and the one
       that used to sit here pointed a SettingsFile at TestSettings.testsettings via
       $(MSBuildProjectDirectory) - an MSBuild property that .runsettings does not expand, at a
       file that does not exist. Its presence alone made the platform treat every run as legacy
       testsettings, which cannot be combined with the XPlat Code Coverage collector, so CI's
       test steps failed before running a single test. -->
</RunSettings>

