# Environment for deploy/docker-compose.unraid.yml
#
# Copy to a file named `.env` NEXT TO the compose file. Compose reads ${VAR}
# substitutions from that file only -- an env_file entry inside a service will not
# satisfy them. In Unraid's Compose Manager this is "Edit Stack" -> the .env tab.
#
# Nothing here belongs in git. deploy/.env is gitignored.

# Apex domain the tunnel serves. The compose file derives every hostname from it:
#   ${NUOTTI_DOMAIN}            -> web
#   audience.${NUOTTI_DOMAIN}   -> audience
#   performer.${NUOTTI_DOMAIN}  -> performer
#   api.${NUOTTI_DOMAIN}        -> backend
#   assets.${NUOTTI_DOMAIN}     -> azurite blob endpoint
NUOTTI_DOMAIN=nuotti.app

# Postgres superuser password for the nuotti database. Postgres is not published to
# the host, but this value also ends up in the Backend connection string.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Azurite storage account. DO NOT use the default `devstoreaccount1` account: its key
# is published in Microsoft's docs, and this blob endpoint is exposed to the internet
# so that browsers can follow the SAS URLs the Backend mints. Anyone holding that key
# could forge grants.
#
# The account name must be lowercase alphanumeric. The key must be valid base64:
#   openssl rand -base64 32
AZURITE_ACCOUNT=nuottiassets
AZURITE_ACCOUNT_KEY=
