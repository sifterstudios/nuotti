@using Microsoft.AspNetCore.Components.Forms

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@DialogTitle</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_title" Label="Title" Variant="Variant.Outlined" Class="mb-3"
                      Immediate="true" Required="true" RequiredError="Title is required" />
        <MudTextField @bind-Value="_artist" Label="Artist" Variant="Variant.Outlined"
                      Immediate="true" Required="true" RequiredError="Artist is required" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@(string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_artist))">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string DialogTitle { get; set; } = "Song";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Artist { get; set; } = "";

    string _title = "";
    string _artist = "";

    protected override void OnParametersSet()
    {
        _title = Title;
        _artist = Artist;
    }

    void Cancel() => MudDialog.Cancel();

    void Submit()
    {
        if (string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_artist)) return;
        MudDialog.Close(DialogResult.Ok(new SongEditModel(_title.Trim(), _artist.Trim())));
    }
}

