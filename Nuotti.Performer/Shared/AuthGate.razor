@using Nuotti.Performer.Services
@inject WorkspaceSession Session
@inject NavigationManager Nav

@* Session.IsReady alone is enough to pass the gate: SignIn already selected a workspace before
   NavigateTo("/"), and requiring _checked there left a permanent spinner after leaving /signin
   (the readiness check is skipped on that page and never re-ran). *@
@if (IsSignInPage || Session.IsReady)
{
    @ChildContent
}
else if (_checked)
{
    @* Redirect already issued; this is what the browser shows for the instant before it lands. *@
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
        <MudText Typo="Typo.body1" Color="Color.Secondary">Redirecting to sign in&hellip;</MudText>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    </MudContainer>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    bool _checked;

    bool IsSignInPage =>
        Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/').StartsWith("signin", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Runs after render, not on initialize: the stored token lives in ProtectedLocalStorage,
    /// which needs a JS runtime that prerendering does not have. Checking earlier would decide
    /// "not signed in" for every user on every first paint.
    /// </summary>
    /// <remarks>
    /// Do not gate on <c>firstRender</c>. Sign-in skips this check, then navigates home on the
    /// same AuthGate instance; a firstRender-only gate would never run and would leave the
    /// spinner up forever if Session.IsReady were somehow still false.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_checked || IsSignInPage || Session.IsReady) return;

        await Session.EnsureReadyAsync();
        _checked = true;

        if (!Session.IsReady) Nav.NavigateTo("/signin");
        StateHasChanged();
    }
}
