                </div>
                <div class="wizard-layout">
                  <aside class="step-rail">
                    <div class="step done"><b>1</b><span>Song identity<small>Take On Me · a-ha</small></span></div>
                    <div class="step active"><b>2</b><span>Playback<small>Choose what the band needs</small></span></div>
                    <div class="step"><b>3</b><span>Hints<small>At least one required</small></span></div>
                    <div class="step"><b>4</b><span>Lyrics<small>Optional</small></span></div>
                    <div class="step"><b>5</b><span>Review<small>Preview and publish</small></span></div>
