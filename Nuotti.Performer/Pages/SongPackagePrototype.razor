@page "/prototype/song-package"
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components.Rendering
@inject NavigationManager Navigation

@* PROTOTYPE — Three Song Package authoring layouts, switchable via ?variant=, in the real Performer shell. *@

<div class="prototype-page" tabindex="0" @onkeydown="HandleKeyDown">
    <DynamicComponent Type="@VariantComponentType" />

#if DEBUG
    <MudPaper Class="prototype-switcher pa-2" Elevation="12">
        <MudIconButton Icon="@Material.Filled.ArrowBack" OnClick="@(() => Cycle(-1))" />
        <MudText Typo="Typo.subtitle2" Class="px-3">@Variant — @VariantName</MudText>
        <MudIconButton Icon="@Material.Filled.ArrowForward" OnClick="@(() => Cycle(1))" />
    </MudPaper>
#endif
</div>

@code {
    private static readonly string[] Variants = ["A", "B", "C"];

    private string Variant
    {
        get
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var query = QueryHelpers.ParseQuery(uri.Query);
            var requested = query.TryGetValue("variant", out var value)
                ? value.ToString().ToUpperInvariant()
                : "A";
            return Variants.Contains(requested) ? requested : "A";
        }
    }

    private string VariantName => Variant switch
    {
        "A" => "Guided journey",
        "B" => "Readiness workspace",
        _ => "Studio split view"
    };

    private Type VariantComponentType => Variant switch
    {
        "A" => typeof(VariantA),
        "B" => typeof(VariantB),
        _ => typeof(VariantC)
    };

    private void Cycle(int direction)
    {
        var current = Array.IndexOf(Variants, Variant);
        var next = (current + direction + Variants.Length) % Variants.Length;
        Navigation.NavigateTo($"/prototype/song-package?variant={Variants[next]}");
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "ArrowLeft") Cycle(-1);
        if (args.Key == "ArrowRight") Cycle(1);
    }

    private sealed class VariantA : ComponentBase
    {
        protected override void BuildRenderTree(RenderTreeBuilder builder)
        {
            builder.OpenComponent<GuidedJourney>(0);
            builder.CloseComponent();
        }
    }

    private sealed class VariantB : ComponentBase
    {
        protected override void BuildRenderTree(RenderTreeBuilder builder)
        {
            builder.OpenComponent<ReadinessWorkspace>(0);
            builder.CloseComponent();
        }
    }

    private sealed class VariantC : ComponentBase
    {
        protected override void BuildRenderTree(RenderTreeBuilder builder)
        {
            builder.OpenComponent<StudioSplitView>(0);
            builder.CloseComponent();
        }
    }
}

@code {
    private sealed class GuidedJourney : ComponentBase
