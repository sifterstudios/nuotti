@page "/setlist"
@inject SongPackageAuthoringClient Api
@inject WorkspaceSession Session
@inject ISnackbar Snackbar

<PageTitle>Setlist Manager · Nuotti</PageTitle>

<MudText Typo="Typo.overline" Class="mb-1" Style="letter-spacing: 0.12em; font-weight: 800; color: var(--mud-palette-primary);">
    Show preparation
</MudText>
<MudText Typo="Typo.h3" Class="mb-2">Setlist Manager</MudText>
<MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mud-palette-text-secondary);">
    Pick published songs from the Song Library and set the order for the show.
    Author and publish packages first, then arrange them here.
</MudText>

@if (!string.IsNullOrWhiteSpace(Session.Error))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@Session.Error</MudAlert>
}

<MudGrid>
    <MudItem xs="12" md="5">
        <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid var(--mud-palette-divider); height: 100%;">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6" Style="font-weight: 700;">Published library</MudText>
                <MudIconButton Icon="@Material.Filled.Refresh" OnClick="ReloadAsync" Disabled="@Busy" aria-label="Refresh" />
            </MudStack>

            @if (Available.Count == 0 && !Busy)
            {
                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                    No published songs yet.
                    <MudLink Href="/song-library">Add songs</MudLink>
                    and publish a package revision before building a setlist.
                </MudText>
            }
            else
            {
                <MudList T="string" Dense="true">
                    @foreach (var song in Available)
                    {
                        var alreadyIn = Songs.Any(x => x.PackageRevisionId == song.PackageRevisionId);
                        <MudListItem T="string" Disabled="@(alreadyIn || Busy)">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
                                <div>
                                    <MudText Typo="Typo.subtitle2">@song.Title</MudText>
                                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                                        @song.Artist · rev @song.RevisionNumber
                                    </MudText>
                                </div>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                           Disabled="@(alreadyIn || Busy)"
                                           OnClick="@(() => AddSong(song))">
                                    @(alreadyIn ? "In setlist" : "Add")
                                </MudButton>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="7">
        <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid var(--mud-palette-divider);">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6" Style="font-weight: 700;">Tonight’s setlist</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Material.Filled.Save"
                           OnClick="SaveAsync" Disabled="@(Busy || !Dirty)">
                    Save setlist
                </MudButton>
            </MudStack>

            @if (Songs.Count == 0)
            {
                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                    Empty. Add published songs from the left.
                </MudText>
            }
            else
            {
                <MudTable Items="@Songs" Dense="true" Hover="true" Breakpoint="Breakpoint.None">
                    <HeaderContent>
                        <MudTh Style="width: 48px;">#</MudTh>
                        <MudTh>Song</MudTh>
                        <MudTh Style="width: 160px;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @{
                            var index = Songs.IndexOf(context);
                        }
                        <MudTd>@(index + 1)</MudTd>
                        <MudTd>
                            <MudText Typo="Typo.subtitle2">@LabelFor(context)</MudText>
                            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                                @context.PackageRevisionId
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudStack Row="true" Spacing="0">
                                <MudIconButton Icon="@Material.Filled.ArrowUpward" Size="Size.Small"
                                               Disabled="@(Busy || index == 0)"
                                               OnClick="@(() => Move(index, -1))" aria-label="Move up" />
                                <MudIconButton Icon="@Material.Filled.ArrowDownward" Size="Size.Small"
                                               Disabled="@(Busy || index == Songs.Count - 1)"
                                               OnClick="@(() => Move(index, 1))" aria-label="Move down" />
                                <MudIconButton Icon="@Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               Disabled="@Busy"
                                               OnClick="@(() => Remove(index))" aria-label="Remove" />
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    readonly List<PublishedLibrarySongDto> Available = [];
    readonly List<SetlistSongDto> Songs = [];
    bool Busy;
    bool Dirty;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureReadyAsync();
        await ReloadAsync();
    }

    async Task ReloadAsync()
    {
        if (!Session.IsReady) return;
        Busy = true;
        try
        {
            var published = await Api.ListPublishedLibraryAsync(Session.WorkspaceId!, Session.SessionToken!);
            Available.Clear();
            Available.AddRange(published);

            var setlist = await Api.GetSetlistAsync(Session.WorkspaceId!, Session.SessionToken!);
            Songs.Clear();
            Songs.AddRange(setlist.Songs);
            Dirty = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            Busy = false;
        }
    }

    void AddSong(PublishedLibrarySongDto song)
    {
        if (Songs.Any(x => x.PackageRevisionId == song.PackageRevisionId)) return;
        Songs.Add(new SetlistSongDto(song.PackageRevisionId));
        Dirty = true;
    }

    void Remove(int index)
    {
        if (index < 0 || index >= Songs.Count) return;
        Songs.RemoveAt(index);
        Dirty = true;
    }

    void Move(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= Songs.Count) return;
        (Songs[index], Songs[target]) = (Songs[target], Songs[index]);
        Dirty = true;
    }

    async Task SaveAsync()
    {
        if (!Session.IsReady) return;
        Busy = true;
        try
        {
            var saved = await Api.SaveSetlistAsync(Session.WorkspaceId!, Session.SessionToken!, Songs.ToArray());
            Songs.Clear();
            Songs.AddRange(saved.Songs);
            Dirty = false;
            Snackbar.Add("Setlist saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            Busy = false;
        }
    }

    string LabelFor(SetlistSongDto song)
    {
        var match = Available.FirstOrDefault(x => x.PackageRevisionId == song.PackageRevisionId);
        return match is null ? song.PackageRevisionId : $"{match.Title} — {match.Artist} (rev {match.RevisionNumber})";
    }
}
