{
  "ServiceName": "Nuotti.Backend",
  "Greeting": "Hello from Development",
  "Nuotti": {
    "Realtime": {
      // The local loop still runs clients that have not been migrated onto credentials yet.
      // Deployed environments leave this unset, so /hub there admits nobody it cannot identify.
      "AllowUnauthenticatedConnections": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Npgsql": "Warning",
      "Npgsql.Command": "Warning"
    }
  }
}
